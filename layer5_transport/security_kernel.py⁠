import hashlib
import time

class SovereignSecurityKernel:
    def __init__(self, window_seconds: int = 30):
        self.window_seconds = window_seconds
        self.seen_nonces = set()

    def generate_nonce(self) -> str:
        """توليد معرف فريد يعتمد على الوقت الحالي لمنع هجمات إعادة التشغيل."""
        timestamp = str(time.time())
        return hashlib.sha256(timestamp.encode()).hexdigest()[:16]

    def verify_packet(self, nonce: str, timestamp: float) -> bool:
        """التحقق من صحة الحزمة ومنع إعادة إرسال نفس المعرف ضمن النافذة الزمنية."""
        current_time = time.time()
        
        # التحقق من أن الحزمة ضمن النافذة الزمنية المسموحة
        if abs(current_time - timestamp) > self.window_seconds:
            return False
            
        # التحقق من أن المعرف لم يتم استخدامه مسبقاً
        if nonce in self.seen_nonces:
            return False
            
        # تسجيل المعرف كمعالج
        self.seen_nonces.add(nonce)
        return True
