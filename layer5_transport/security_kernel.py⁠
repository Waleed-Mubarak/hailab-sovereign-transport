import hmac
import hashlib

class SovereignSecurityKernel:
    """نواة الأمان السيادية (Security Kernel) لتنفيذ سياسات الثقة المعدومة (Zero-Trust)."""
    
    def __init__(self, kernel_secret: bytes = None):
        self._kernel_secret = kernel_secret or b"sovereign_kernel_master_key_32bytes!!"
        self._audit_log = []

    def evaluate_and_authorize(self, session_controller, session_token: bytes, incoming_state: dict, incoming_signature: bytes, destination_node: str) -> bool:
        """
        التقييم الأمني الشامل واتخاذ قرار التفويض (Authorization Decision):
        1. التحقق من سلامة الجلسة والتوقيع ومنع إعادة التشغيل عبر المتحكم.
        2. التحقق من مطابقة وجهة العقدة (Destination Binding).
        3. تسجيل القرار في سجل التدقيق الأمني (Audit Trail).
        """
        
        # الخطوة الأولى: التحقق عبر متحكم الجلسات (يتحقق من التوقيع، الجلسة، والعداد لمنع Replay Attacks)
        is_session_valid = session_controller.validate_and_update_state(
            session_token=session_token,
            incoming_state=incoming_state,
            incoming_signature=incoming_signature
        )
        
        if not is_session_valid:
            self._log_audit_event("DENIED", "Invalid session, bad signature, or replay attack detected", destination_node)
            return False

        # الخطوة الثانية: التحقق من سياسة الوجهة (Policy Enforcement)
        if not destination_node or not isinstance(destination_node, str):
            self._log_audit_event("DENIED", "Invalid or missing destination node binding", destination_node)
            return False

        # الخطوة الثالثة: التحقق من سلامة الحمولة ضد محاولات حقن البيانات
        if not self._verify_payload_integrity(incoming_state):
            self._log_audit_event("DENIED", "Payload integrity check failed", destination_node)
            return False

        # منح الإذن السيادي بنجاح
        self._log_audit_event("AUTHORIZED", "Security kernel check passed successfully", destination_node)
        return True

    def _verify_payload_integrity(self, state: dict) -> bool:
        """التحقق من خلو الحالة من القيم غير المسموحة أو الهياكل التخريبية."""
        if not isinstance(state, dict):
            return false
        # التأكد من وجود العداد الأساسي لمنع التلاعب بالمعايير المؤسسية
        if "counter" not in state:
            return False
        return True

    def _log_audit_event(self, status: str, reason: str, node: str):
        """تسجيل الأحداث الأمنية داخلياً لغرض التدقيق والمراقبة."""
        event = {
            "status": status,
            "reason": reason,
            "destination": node
        }
        self._audit_log.append(event)
        # الاحتفاظ آخر 100 سجل فقط لمنع استنزاف الذاكرة
        if len(self._audit_log) > 100:
            self._audit_log.pop(0)

    def get_audit_trail(self) -> list:
        """استرجاع سجل التدقيق الأمني."""
        return list(self._audit_log)

    def __setattr__(self, name, value):
        if name not in ["_kernel_secret", "_audit_log"]:
            raise AttributeError("Direct modification of kernel security attributes is strictly prohibited.")
        super().__setattr__(name, value)
