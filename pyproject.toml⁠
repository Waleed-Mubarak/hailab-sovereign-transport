[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "hailab-sovereign-transport"
version = "0.1.0"
requires-python = ">=3.10"
dependencies = [
    "pytest"
]

[tool.setuptools]
py-modules = [
    "wp6_pqc_layer",
    "cbt_compatibility_layer",
    "cryptography_security_layer",
    "sovereign_transport_kernel",
    "ai_sovereign_bridge",
    "audit_verifier",
    "chaos_sim",
    "hailab_sovereign"
]
